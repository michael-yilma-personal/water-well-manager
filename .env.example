# Supabase project the field app and admin dashboard sync to.
#
# Both values are baked into the bundle at build time. That is safe for the
# publishable key ONLY because Row Level Security is enabled on every table -
# see supabase/migrations/. Never put an `sb_secret_...` key here; it would ship
# inside the APK.
#
# Copy this file to .env.local (git-ignored) and fill in your project's values
# from Supabase -> Project Settings -> API.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
