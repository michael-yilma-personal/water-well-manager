.env*
!.env.example

# --- Release signing: NEVER commit these ---------------------------------
# keystore.properties holds the store/key passwords in plaintext and the .jks
# is the signing key itself. If either leaks, anyone can sign an APK that
# Android will accept as a legitimate update to this app.
android/keystore.properties
*.jks
*.keystore
*.p12

# --- Android build output / machine-specific -----------------------------
android/.gradle/
android/local.properties
android/.idea/
android/app/release/
# Web assets copied in by `npx cap sync`; regenerate with
# `npm run build && npx cap sync android`
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

