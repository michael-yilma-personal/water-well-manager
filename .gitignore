node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# --- Release signing: NEVER commit these ---------------------------------
# keystore.properties holds the store/key passwords in plaintext and the .jks
# is the signing key itself. If either leaks, anyone can sign an APK that
# Android will accept as a legitimate update to this app.
android/keystore.properties
*.jks
*.keystore
*.p12

# --- Android build output / machine-specific -----------------------------
android/.gradle/
android/local.properties
android/.idea/
android/app/release/
# Web assets copied in by `npx cap sync`; regenerate with
# `npm run build && npx cap sync android`
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# --- Editors / misc -------------------------------------------------------
.idea/
.vscode/
*.iml
_to_delete/

# --- SaaS workflow: finding detail that must not be published -------------
docs/saas/private/

# --- Supabase CLI link state: machine-specific, and must never point this
# working copy at production by default --------------------------------------
supabase/.temp/

# Python bytecode
__pycache__/

# --- Local files: never commit ---------------------------------------------
.secrets.local
*.secrets.local

